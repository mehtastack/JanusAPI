{
  "name": "@apijanus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "JanusAPI is a desktop API client with Janus, an AI assistant that works with your own model provider or a local model.",
  "desktopName": "janusapi.desktop",
  "homepage": "https://mehtastack.com/janusapi",
  "repository": "github:mehtastack/JanusAPI",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "electron-vite build && playwright test",
    "eval:find": "vitest run --config vitest.eval.config.ts",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "@apijanus/agent": "workspace:*",
    "@apijanus/core": "workspace:*",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chai": "4.5.0",
    "electron-updater": "^6.8.9",
    "quickjs-emscripten": "^0.31.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "7.30.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
