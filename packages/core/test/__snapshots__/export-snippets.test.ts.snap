exports[`golden snippets > go > body: text 1`] = `
"package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	body := strings.NewReader("hello \`world\` \\"q\\" \\\\ ünï")
	req, err := http.NewRequest("PUT", "https://api.example.com/users", body)
	if err != nil {
		panic(err)
	}
	req.Header.Add("Content-Type", "text/plain")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}"
`;

